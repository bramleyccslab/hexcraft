# Counterfactual effect size is basically just the pearson correlation between the cause and the effect across the counterfactual sample
calculate_ces<-function(df, n)
{
ces<-list()
for (i in 1:(ncol(df)-1))
{
suppressWarnings( ces[names(df)[i]]<-cor(df[[names(df)[i]]][1:n], df$E[1:n]) )
}
unlist(ces)
}
#An example: Everything happened. What is the counterfactual effect size of of every variable
# Varying how long of a chain we look at to establish it from...?
# Let's run a long chain
n_samples<-10000
cf_samples<-prior_samples<-data.frame(Au=rep(NA, n_samples),
A=rep(NA, n_samples),
ABu=rep(NA, n_samples),
Bu=rep(NA, n_samples),
B=rep(NA, n_samples),
BCu=rep(NA, n_samples),
Cu=rep(NA, n_samples),
C=rep(NA, n_samples),
BDu=rep(NA, n_samples),
Du=rep(NA, n_samples),
D=rep(NA, n_samples),
CEu=rep(NA, n_samples),
DEu=rep(NA, n_samples),
Eu=rep(NA, n_samples),
E=rep(NA, n_samples))
cf_samples[1,]<-prior_samples[1,]<-unlist(initial_state)
# Loop along the chain generating the samples
for (step in 2:n_samples)
{
cf_samples[step,]<-resample_state(as.list(cf_samples[step-1,]), verbose = T)
# Also generate samples frmo the prior as a useful comparison set
prior_samples[step,]<-unlist(sample_state())
}
# Check that everything varies (isn't 1 or 0) which can happen if the parameters are too extreme
colMeans(cf_samples)
calculate_ces(cf_samples, n=100)
calculate_ces(cf_samples, n=1000)
calculate_ces(cf_samples, n=10000)
# Compare with sampling all your counterfactuals from your prior
calculate_ces(prior_samples, n=10000)
# Todo: Tadeg's model: with p=1-s resample states
# Here is the adjacency matrix (but I don't actually use this)
g<-matrix(0, 15,15, dimnames = list(variables, variables))
g['Au','A']<-g['ABu','B']<-g['Bu','B']<-g['BCu','C']<-
g['Cu','C']<-g['BDu','D']<-g['Du','D']<-g['CEu','E']<-g['DEu','E']<-g['Eu','E']<-1
g
# Here is the state space all binary variables can be set to zero or one.
empty_state<-list(Au=NA,A=NA,ABu=NA,Bu=NA,B=NA,BCu=NA,Cu=NA,C=NA, BDu=NA,Du=NA,D=NA,CEu=NA,DEu=NA,Eu=NA,E=NA)
# Canonically we suppose we observe everything observable happen (so A, B, C, D and E are all 1),
# Au must presumably have been 1, we don't know if the other base rates were 1 (we can do inference about them if we want but lets just set to zero for now)
initial_state<-list(Au=1,A=1,ABu=1,Bu=0,B=1,BCu=1,Cu=0,C=1, BDu=1,Du=0,D=1,CEu=1,DEu=1,Eu=0,E=1)
initial_state
unlist(initial_state)
#Causal model
rm(list=ls())
# Let's define a causal graph in a diamond formation A->B C<-B->D and C->E<-D
# Let's represent it in the Structural causal model style where all probabilities are separate nodes on the outside
variables<-c('Au','A','ABu','Bu','B','BCu','Cu','C', 'BDu','Du','D','CEu','DEu','Eu','E')
# Here is the adjacency matrix (but I don't actually use this)
g<-matrix(0, 15,15, dimnames = list(variables, variables))
g['Au','A']<-g['ABu','B']<-g['Bu','B']<-g['BCu','C']<-
g['Cu','C']<-g['BDu','D']<-g['Du','D']<-g['CEu','E']<-g['DEu','E']<-g['Eu','E']<-1
# Here is the state space all binary variables can be set to zero or one.
empty_state<-list(Au=NA,A=NA,ABu=NA,Bu=NA,B=NA,BCu=NA,Cu=NA,C=NA, BDu=NA,Du=NA,D=NA,CEu=NA,DEu=NA,Eu=NA,E=NA)
# Canonically we suppose we observe everything observable happen (so A, B, C, D and E are all 1),
# Au must presumably have been 1, we don't know if the other base rates were 1 (we can do inference about them if we want but lets just set to zero for now)
initial_state<-list(Au=1,A=1,ABu=1,Bu=0,B=1,BCu=1,Cu=0,C=1, BDu=1,Du=0,D=1,CEu=1,DEu=1,Eu=0,E=1)
# Here are some pretty arbitrary parameters to illustrate the model. Au is the probability that Au's "exogenous base rate" causes it to happen
# ABu is the probability that the edge from A to B works (assuming A is 1) and so on
# So Bu is the probability that Bu happens by itself (its exogenous base rate)
# implicitly the probability of B is a noisy OR of Au(if A=1) with Bu. So we recover the standard causal power type setting
# I assume C->E<-D is disjunctive such that E occurs if either C=1 (and works (CEu=1)) OR D=1 (and works (DEu=1)), OR if it happens spontaneously Eu=1
pp<-list(Au=.6,ABu=.75,Bu=.3,BCu=.8, BDu=.5, Cu=.3, Du=.6, CEu=.7, DEu=.7, Eu=.2)
# this list of functions can be looped over to resample all the exogenous variables as needed
exog_f<-list(
Au=function(s)
{
if (runif(1)<pp$Au){s$Au=1} else {s$Au=0}
s
},
Bu=function(s)
{
if (runif(1)<pp$Bu){s$Bu=1} else {s$Bu=0}
s
},
Cu=function(s)
{
if (runif(1)<pp$Cu){s$Cu=1} else {s$Cu=0}
s
},
Du=function(s)
{
if (runif(1)<pp$Du){s$Du=1} else {s$Du=0}
s
},
Eu=function(s)
{
if (runif(1)<pp$Eu){s$Eu=1} else {s$Eu=0}
s
},
ABu=function(s)
{
if (runif(1)<pp$ABu){s$ABu=1} else {s$ABu=0}
s
},
BCu=function(s)
{
if (runif(1)<pp$BCu){s$BCu=1} else {s$BCu=0}
s
},
BDu=function(s)
{
if (runif(1)<pp$BDu){s$BDu=1} else {s$BDu=0}
s
},
CEu=function(s)
{
if (runif(1)<pp$CEu){s$CEu=1} else {s$CEu=0}
s
},
DEu=function(s)
{
if (runif(1)<pp$DEu){s$DEu=1} else {s$DEu=0}
s
}
)
# This list of functions determines the endogenous variables as a function of the exogenous variables and their parents
# (so make sure you loop through it forward, i.e. in ancestral order)
f<-list(
A=function(s)
{
if (s$Au==1) { s$A<-1 } else {s$A<-0}
s
},
B=function(s)
{
if ((s$A==1 & s$ABu==1) | s$Bu==1) {  s$B<-1 } else { s$B<-0 }
s
},
C=function(s)
{
if ((s$B==1 & s$BCu==1) | s$Cu==1) {  s$C<-1 } else { s$C<-0 }
s
},
D=function(s)
{
if ((s$B==1 & s$BDu==1) | s$Du==1) {  s$D<-1 } else { s$D<-0 }
s
},
E=function(s)
{
if ( ((s$C==1 & s$CEu==1) | (s$D==1 & s$DEu==1)) | s$Eu==1) {  s$E<-1 } else { s$E<-0 }
s
})
sample_state<-function()
{
st<-empty_state
for (i in 1:length(exog_f))
{
st<-exog_f[[i]](st)
}
for (i in 1:length(f))
{
st<-f[[i]](st)
}
st
}
# For example here is a state sampled from the prior
tmp<-sample_state()
# More interesting: let's mutate a state with MCMC:
# So randomly flip an exogenous variable state, update the rest of the graph and
# decide scholastically whether to accept it
resample_state<-function(st, verbose = F)
{
st_prime<-st
# Pick an exogenous variable
ix<-sample(1:length(pp), 1)
#  Flip it
var<-names(pp)[ix]
if (st_prime[var]==0) {st_prime[var]<-1} else {st_prime[var]<-0}
# Update the endogenous variables
for (i in 1:length(f))
{
st_prime<-f[[i]](st_prime)
}
# Compute the likelihood of current hypothesis
li_st<-  sum(log(c(c(1-pp$Au, pp$Au)[st$Au+1],
c(1-pp$Bu, pp$Bu)[st$Bu+1],
c(1-pp$Cu, pp$Cu)[st$Cu+1],
c(1-pp$Du, pp$Du)[st$Du+1],
c(1-pp$Eu, pp$Eu)[st$Eu+1],
c(1-pp$ABu, pp$ABu)[st$ABu+1],
c(1-pp$BCu, pp$BCu)[st$BCu+1],
c(1-pp$BDu, pp$BDu)[st$BDu+1],
c(1-pp$CEu, pp$CEu)[st$CEu+1],
c(1-pp$DEu, pp$DEu)[st$DEu+1])))
# And the new one... (this coudl be done more efficiently! You only NEED to evaluate the changed term)
li_st_prime<-  sum(log(c(c(1-pp$Au, pp$Au)[st_prime$Au+1],
c(1-pp$Bu, pp$Bu)[st_prime$Bu+1],
c(1-pp$Cu, pp$Cu)[st_prime$Cu+1],
c(1-pp$Du, pp$Du)[st_prime$Du+1],
c(1-pp$Eu, pp$Eu)[st_prime$Eu+1],
c(1-pp$ABu, pp$ABu)[st_prime$ABu+1],
c(1-pp$BCu, pp$BCu)[st_prime$BCu+1],
c(1-pp$BDu, pp$BDu)[st_prime$BDu+1],
c(1-pp$CEu, pp$CEu)[st_prime$CEu+1],
c(1-pp$DEu, pp$DEu)[st_prime$DEu+1])))
# Log likeliood ratio
ll_ratio<-li_st_prime - li_st
# Choose whether to accept
if (ll_ratio>=0)
{
if (verbose == T)
{
cat(ix, var, ll_ratio, 'better or same \n')
}
st<-st_prime
} else if (log(runif(1))<ll_ratio) {
cat(ix, var, ll_ratio, 'worse but accepted anyway \n')
st<-st_prime
} else {
cat(ix, var, ll_ratio, 'rejected \n')
}
st
}
